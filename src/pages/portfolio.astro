---
import Layout from '../layouts/Layout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import StickyCopyright from '../components/StickyCopyright.astro';

// Dynamically fetch images for the quick portfolio
const globImages = import.meta.glob<{ default: ImageMetadata }>('/public/images/gallery/quick-portfolio/**/*.{jpeg,jpg,png,gif,webp,JPG,JPEG,PNG,GIF,WEBP}');
const myImagesKeys = Object.keys(globImages);

const loadedImages = await Promise.all(myImagesKeys.map(async key => {
  try {
    const mod = await globImages[key]();
    return {
      src: key.replace('/public', ''),
      metadata: mod.default
    };
  } catch(e) { return null; }
}));

let validImages = loadedImages.filter(img => img !== null);

// Images to completely remove from the gallery (avoid duplicates of the red backlight / hugging couple shoot, and the couple under the tree/wedding shoot/Haldi)
const excludedFiles = [
  'WC__7232.jpg', 'WC__8428.jpg', 'WC__6391.jpg', 
  '083A8242.jpg', '083A8260.jpg', '083A8355.jpg',
  'WC__4597.jpg', 'WC__5748.jpg', 'WC__7186.jpg',
  'SDPH9921.jpg', 'SAM_2941.jpg', 'SDPH2467.jpg',
  'SAM_2009.jpg', 'SAM_2023.jpg', 'SAM_3184.jpg',
  'SAM_3321.jpg', 'SAM_3355.jpg', 'SAM_3356.jpg',
  'SAM_3678.jpg', 'SAM_9682.JPG', 'SAM_3258.jpg',
  'SAM_4750.jpg', 'WC_14557.JPG'
];

// Filter out excluded images first
validImages = validImages.filter(img => {
  return !excludedFiles.some(f => img.src.toLowerCase().endsWith(f.toLowerCase()));
});

// Centralized order of images in the gallery (easy to rearrange by changing position in this array)
const imageOrder = [
