---
import Layout from '../layouts/Layout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import StickyCopyright from '../components/StickyCopyright.astro';

// Dynamically fetch images for the quick portfolio
const globImages = import.meta.glob<{ default: ImageMetadata }>('/public/images/gallery/quick-portfolio/**/*.{jpeg,jpg,png,gif,webp,JPG,JPEG,PNG,GIF,WEBP}');
const myImagesKeys = Object.keys(globImages);

const loadedImages = await Promise.all(myImagesKeys.map(async key => {
  try {
    const mod = await globImages[key]();
    return {
      src: key.replace('/public', ''),
      metadata: mod.default
    };
  } catch(e) { return null; }
}));

let validImages = loadedImages.filter(img => img !== null);

// All images placed inside quick-portfolio folder are included
const imagesMap = new Map();
validImages.forEach(img => {
  const filename = img.src.split('/').pop().toLowerCase();
  imagesMap.set(filename, img);
});

// Centralized order of images in the gallery (Top items preserved, followed by zero-collision distributed shoots)
const imageOrder = [
  "083A8252.jpg",
  "WC__6897.jpg",
  "WC__2755.jpg",
  "WC__3083.JPG",
  "IMG_2653.JPG",
