---
import Layout from '../layouts/Layout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
---

<Layout hideGlobalPreloader={true}>

  <!-- Fonts handled globally via style.css -->

  <div class="about-page">

    <!-- â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
         HERO &mdash; from version 1
    â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� -->
    <section class="profile-section">
      <div class="profile-container">
        <div class="profile-header">
          <p class="section-tag">Founder of Wedding Candid</p>
          <h1 class="director-name">Deep <em>Mistry</em></h1>
          <p class="director-titles">Director / Storyteller / Cinematographer</p>
        </div>

        <div class="profile-content">
          <div class="profile-image-wrap">
            <div class="above-image-quote">
              <blockquote class="manifesto-quote">
                "Relationships change in due period of time,<br />
                The only constant is the <em>memories</em> you captured in photographs"
              </blockquote>
              <p class="founder-tag-inline">Founder of : <strong>WEDDING CANDID</strong></p>
            </div>
            <div class="profile-image-inner">
              <OptimizedImage src="/about/IMG_8611.jpg" alt="Deep Mistry" loading="eager" />
            </div>
          </div>

          <div class="profile-copy">
            <div class="bio-block">
              <p class="bio-intro">
                Deep Mistry is a professional Photographer / Cinematographer renowned for his creative imagery and profound storytelling abilities.
              </p>
              <div class="bio-divider"></div>
              <div class="bio-body">
                <p style="font-style: italic; font-family: var(--font-serif);">
                  "As an artist whose medium of bringing the art to the world is an intent of compartmentalising the moments, I am all about things which are not seen by the naked eye but a soul which feels what cannot be said through any other medium."
                </p>
                <p style="font-family: var(--font-sans);">
                  With a passion for capturing life's most cherished moments, he has carved a niche for himself in the world of photography over the last 9 years. As the founder of WEDDING CANDID, he has elevated the art of Wedding photography, transforming emotional moments into timeless treasures.
                </p>
                <p style="font-family: var(--font-sans);">
                  He has redefined the essence of Wedding photography. His distinctive eye for grabbing the ongoing moment results in stunning visual narratives that resonate deeply with his clients. Each wedding captured by him enables the client to cherish every event even years after its passing, weaving a rich tapestry of emotions, relationships, and memories.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
         INTRO &mdash; from version 2
    â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� -->
    <section class="intro" data-reveal>
      <div class="intro__inner">
        <div class="intro__pull reveal-child">
          <p>
            I am a professional wedding photographer and filmmaker who has spent the last
            nine years doing one thing &mdash; being <em>fully present</em> at the most important
            day of your life.
          </p>
        </div>
        <div class="intro__body reveal-child">
          <p>
            My work is not about perfect poses or manufactured smiles. It is about the
            split-second glance between a father and his daughter before she walks down the
            aisle. The private laugh only the two of you share. The quiet exhale of a bride
            the moment everything becomes real. Those are the moments I live for &mdash; and the
            ones I will carry back to you, forever.
          </p>
          <p>
            As the founder of <strong>Wedding Candid</strong>, I have built a practice
            rooted in trust, emotion, and craft. Every frame I deliver is a piece of your
            story &mdash; not mine.
          </p>
        </div>
      </div>
    </section>

    <!-- â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
         TURNING POINT &mdash; from version 2
    â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� -->
    <section class="turning" data-reveal>
      <div class="turning__inner">
        <div class="turning__left reveal-child">
          <span class="turning__label">The Moment Everything Changed</span>
          <div class="turning__line"></div>
        </div>
        <div class="turning__right">
          <h2 class="turning__headline reveal-child">
            My first wedding<br />taught me what<br /><em>this really means.</em>
          </h2>
          <div class="turning__copy reveal-child">
            <p>
              The moment I shot my first wedding, I felt the weight of it. These were not
              clients &mdash; they were people placing one of the most precious days of their lives
              in my hands. They trusted me completely. That trust changed how I approach
              every single wedding I photograph.
            </p>
            <p>
              I realised that the skills I had been sharpening for years were not just about
              beautiful photos. They carried <em>real weight</em> &mdash; the responsibility to
              preserve what can never be recreated, and to return it as a memory that grows
              richer with every passing year.
            </p>
            <p>
              Every time I pick up my camera, I feel that same quiet responsibility. And I
              would not have it any other way.
            </p>
          </div>
          <div class="turning__stat reveal-child">
            <span class="stat-num">9</span>
            <span class="stat-text">Years of weddings,<br/>each one irreplaceable</span>
          </div>
        </div>
      </div>
    </section>


    <!-- â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
         JOURNEY &mdash; from version 2
    â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� -->
    <section class="journey" data-reveal>
      <div class="journey__inner">
        <div class="journey__img-pair reveal-child">
          <div class="jpair-img">
            <OptimizedImage src="/about/IMG_4490.jpg" alt="Wedding moment" loading="eager" />
          </div>
          <div class="jpair-img">
            <OptimizedImage src="/about/b4fc1a98-15f2-49ad-abf0-20a0ad3614c2.jpg" alt="Wedding moment" loading="eager" />
            <div class="journey__year-badge">2017 &rarr; Now</div>
          </div>
        </div>
        <div class="journey__text">
          <p class="journey__eyebrow reveal-child">The Journey</p>
          <h2 class="journey__headline reveal-child">
            A Heritage<br />Built on <em>Commitment</em>
          </h2>
          <div class="journey__copy reveal-child">
            <p>
              I first picked up a camera in 2017 and bought my own in 2018. I spent months
              assisting on shoots, learning the craft from the ground up &mdash; from production
              sets to family portraits to smaller celebrations.
            </p>
            <p>
              One night, I made the decision to commit fully. I threw everything I had into
              building Wedding Candid &mdash; not just as a business, but as a promise to every
              couple who would ever trust me with their story.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
         LETTER &mdash; from version 2
    â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� -->
    <section class="letter" data-reveal>
      <div class="letter__inner reveal-child">
        <p class="letter__eyebrow">A note from Deep</p>
        <div class="letter__body">
          <p>
            Thank you for taking the time to read my story. I know you have many choices
            when it comes to your wedding photographer &mdash; and I don't take it lightly when
            someone stops to genuinely connect with what I do. It means more than I can say.
          </p>
          <p>
            If you are here, you are looking for someone who will care about your day as
            much as you do. I promise you &mdash; I will. I am excited for the chance to meet
            you, hear your story, and hopefully create something together that you will
            treasure for the rest of your lives.
          </p>
        </div>
        <div class="letter__sig">
          <span class="letter__dash">&mdash;</span>
          <span class="letter__name">Deep Mistry</span>
          <span class="letter__brand">Wedding Candid</span>
        </div>
      </div>
    </section>

    <!-- â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
         CTA &mdash; from version 2
    â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� -->
    <section class="cta" data-reveal>
      <div class="cta__inner reveal-child">
        <h2 class="cta__headline">
          Let's tell your story<br /><em>together.</em>
        </h2>
        <p class="cta__sub">Every great wedding starts with a conversation.</p>
        <a href="/booking" class="cta__btn">Begin Your Story</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* â”€â”€ SHARED TOKENS â”€â”€ */
  :root {
    --ink:        #1a1814;
    --paper:      #f8f6f2;
    --bg:         #faf9f6;
    --bg-soft:    #f2ede6;
    --bg-dark:    #1a1714;
    --ink-mid:    #57534e;
    --ink-light:  #a8a29e;
    --gold:       #b68b40;
    --gold-pale:  #e8d8bc;
    --ease:       cubic-bezier(0.16, 1, 0.3, 1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .about-page {
    background: var(--paper);
    color: var(--ink);
    overflow-x: hidden;
    padding-bottom: 8rem;
  }

  em { font-style: italic; color: var(--gold); }

  /* â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
     REVEAL SYSTEM
  â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� */
  .reveal-child {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
  }
  .reveal-child.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-child:nth-child(2) { transition-delay: 0.1s; }
  .reveal-child:nth-child(3) { transition-delay: 0.2s; }
  .reveal-child:nth-child(4) { transition-delay: 0.3s; }
  .reveal-child:nth-child(5) { transition-delay: 0.4s; }
  .reveal-child:nth-child(6) { transition-delay: 0.5s; }

  /* â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
     HERO &mdash; version 1 styles
  â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� */
  /* â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
     PREMIUM EDITORIAL HERO
  â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� */
  .profile-section {
    padding: 8rem 5vw 6rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* â”€â”€ RESTORED 2-COLUMN LAYOUT â”€â”€ */
  .profile-header {
    text-align: center;
    margin-bottom: 6rem;
  }
  .section-tag {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 1.2rem;
  }
  .director-name {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 300;
    line-height: 1;
  }
  .director-name em { font-style: italic; color: var(--gold); }
  .director-titles {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-top: 2rem;
    display: inline-block;
    padding: 0.6rem 2.2rem;
    border-top: 1px solid rgba(182, 139, 64, 0.25);
    border-bottom: 1px solid rgba(182, 139, 64, 0.25);
  }
  .profile-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    align-items: start;
  }
  .profile-image-wrap { position: relative; }
  .above-image-quote {
    text-align: center;
    margin-bottom: 1.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .profile-image-inner {
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 4/5;
  }
  .profile-image-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* â”€â”€ QUOTE OVERLAY â”€â”€ */
  .image-quote-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 2rem;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.08) 0%,
      rgba(0,0,0,0.52) 40%,
      rgba(0,0,0,0.68) 60%,
      rgba(0,0,0,0.18) 100%
    );
    z-index: 2;
    gap: 0.75rem;
  }
  .manifesto-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 400;
    line-height: 1.55;
    color: #1a1814;
    font-style: italic;
    border: none;
    padding: 0;
    margin: 0;
  }
  .manifesto-quote em { color: var(--gold); }

  /* Overlay-specific overrides */
  .overlay-quote {
    color: rgba(255,255,255,0.95);
    text-shadow: 0 1px 12px rgba(0,0,0,0.4);
  }
  .overlay-quote em {
    color: var(--gold-pale);
  }
  .founder-tag-inline {
    font-family: var(--font-sans);
    font-size: 0.70rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.5);
  }
  .founder-tag-inline strong { color: var(--gold); font-weight: 500; }
  .overlay-founder {
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.28em;
  }
  .overlay-founder strong { color: var(--gold-pale); }
  .bio-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bio-intro {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    font-weight: 700;
    color: var(--ink);
    text-align: center;
  }
  .bio-divider {
    width: 50px; height: 1px; background: var(--gold); margin-left: 0;
  }
  .bio-body {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.9;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    text-align: left;
  }

  .profile-header-premium {
    text-align: center;
    margin-bottom: 12rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .editorial-title-wrap {
    position: relative;
    display: inline-block;
    padding: 2rem 0;
    max-width: 95vw;
  }

  .founder-tag {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: 4rem;
    opacity: 0.9;
  }

  .editorial-name {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 8vw, 7.5rem);
    font-weight: 900;
    line-height: 0.95;
    color: white;
    background: var(--gold-pale);
    padding: 1.5rem 3vw;
    letter-spacing: -0.04em;
    margin: 0;
    position: relative;
    z-index: 1;
    white-space: nowrap;
    box-shadow: 0 40px 120px rgba(182,139,64,0.15);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 18vw;
  }
  .editorial-name span:first-child {
    text-align: right;
  }
  .editorial-name span:last-child {
    text-align: left;
  }

  .name-spacer {
    display: none; /* Switching to CSS Gap for better control */
  }

  .cutout-wrapper-editorial {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
    width: clamp(120px, 20vw, 280px); /* Smaller cutout to clear all letters */
    aspect-ratio: 4/5;
    z-index: 10;
    pointer-events: none;
    overflow: hidden;
    clip-path: polygon(10% 0%, 90% 0%, 100% 100%, 0% 100%); 
    transition: transform 0.5s var(--ease);
  }

  .editorial-title-wrap:hover .cutout-wrapper-editorial {
    transform: translate(-50%, -60%) scale(1.05);
  }

  .deep-portrait-hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: saturate(1.1) brightness(1.05);
  }

  .portrait-fade-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(232, 216, 188, 0.4), transparent 40%);
    mix-blend-mode: multiply;
  }

  /* director-titles override removed — using primary definition above */

  .profile-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    align-items: start;
  }
  
  .profile-copy {
    text-align: left;
  }

  .bio-divider {
    width: 60px;
    height: 1px;
    background: var(--gold);
    margin: 2.5rem auto;
    opacity: 0.4;
  }
  .profile-image-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 1.2s var(--ease);
  }
  .profile-badge {
    position: absolute;
    bottom: -2rem; right: -2rem;
    background: var(--gold);
    color: white;
    padding: 2rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    border-radius: 2px;
    box-shadow: 0 10px 40px rgba(182,139,64,0.3);
  }

  .bio-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bio-intro {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    font-weight: 700;
    color: var(--ink);
    text-align: center;
    text-wrap: balance;
  }
  .bio-divider {
    width: 50px; height: 1px; background: var(--gold); margin-left: 0;
  }
  .bio-body {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.9;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    text-align: left;
  }

  /* â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�
     INTRO
  â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•�â•� */
  .intro {
    padding: 8rem 6vw;
    background: var(--bg-soft);
  }
  .intro__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    align-items: start;
  }
  .intro__pull p {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink);
  }
  .intro__pull em { color: var(--gold); font-style: italic; }
  .intro__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 0.4rem;
  }
  .intro__body p {
    font-size: 1rem;
    line-height: 1.9;
    color: var(--ink-mid);
    font-weight: 300;
    font-family: var(--font-sans);
  }
  .intro__body strong { color: var(--gold); font-weight: 500; }

