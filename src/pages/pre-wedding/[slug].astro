  .story-page { background: var(--paper); color: var(--ink); overflow-x: hidden; }
  .entrance-peel { position: fixed; inset: 0; background: var(--paper); z-index: 9999; transform-origin: top; }

  /* ── Full-Bleed Hero ── */
