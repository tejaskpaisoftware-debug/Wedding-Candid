<Layout title={`${story.name1} & ${story.name2} | Wedding Story`} hideGlobalPreloader={true}>
  <div class="story-page" id="storyPage">
    <div id="entrancePeel" class="entrance-peel"></div>

    <!-- Section 1 — Full-Bleed Hero -->
    <section class="story-hero">
      <div class="hero-bg-wrap">
        <OptimizedImage src={story.cover} alt="Cover" class="hero-cover-img" loading="eager" />
        <div class="hero-bg-overlay"></div>
      </div>
      <div class="hero-content-overlay">
        <p class="story-of-tag">PRE � WEDDING</p>
        <h1 class="couple-display-title">
          {story.name1} <span class="amp">&</span> {story.name2}
        </h1>
        <p class="story-subtitle">{story.location}</p>
      </div>
      <div class="hero-scroll-hint">
        <span class="scroll-hint-line"></span>
        <span class="scroll-hint-text">SCROLL</span>
      </div>
    </section>

    <!-- Section 2 — Quote -->
    <section class="story-quote-block">
      <div class="quote-container">
        <div class="quote-inner">
          <blockquote class="soul-manifesto animate-on-scroll">
            {story.quote}
          </blockquote>
          <div class="quote-sep"></div>
          <p class="quote-author-sig animate-on-scroll">{story.name1} & {story.name2}</p>
        </div>
      </div>
    </section>

    <!-- Section 3 — Gallery -->
    <section class="story-gallery-sec" id="gallery-section">
      <div class="gallery-heading">
        <span class="heading-label">THE JOURNEY STORY</span>
        <div class="heading-rule animate-on-scroll"></div>
      </div>

      <div class="masonry-grid">
        {finalShuffledImages.map((img, i) => {
          // Calculate exact aspect ratio instead of hardcoding
          const ratio = img.metadata ? `${img.metadata.width}/${img.metadata.height}` : '3/4';
          return (
            <div class="gallery-item" data-index={i + 1} data-full={img.src} style={`aspect-ratio: ${ratio}`}>
              <div class="gallery-item-inner">
                <OptimizedImage src={img.src} alt="Shot" loading="lazy" class="w-full h-full object-cover" />
                <div class="item-hover-info">
                  <span class="item-names">{story.name1} & {story.name2}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Footer Space -->
    <div class="next-story-nav">
        <a href={`/pre-wedding/${story.next.slug}`} class="next-story-link">
          <span class="next-label">NEXT STORY</span>
          <span class="next-couple">{story.next.names}</span>
          <div class="next-nav-line"></div>
        </a>
    </div>

    <!-- UI Elements -->
    <div id="scrollProgress" class="fixed-progress">
      <span id="currIdx">01</span> / <span id="totalIdx">{finalShuffledImages.length}</span>
    </div>

    <!-- Lightbox -->
    <div id="lightbox" class="premium-lightbox" hidden>
      <div class="lb-header">
        <div class="lb-counter"></div>
        <button class="lb-close">✕</button>
      </div>
      <div class="lb-stage">
        <button class="lb-arrow prev">←</button>
        <div class="lb-img-wrap">
          <img id="lbBg" class="lb-bg" src="" alt="" aria-hidden="true" />
          <div class="watermark-container lb-watermark-wrap">
                        <img id="lbImg" src="" alt="View" />
            
          </div>
        </div>
        <button class="lb-arrow next">→</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  :root {
    --paper: #f5f2ed;
    --ink: #1a1410;
    --gold: #b68b40;
    --muted: #8a7e72;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
