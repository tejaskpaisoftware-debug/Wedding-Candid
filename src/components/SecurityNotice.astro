---
/**
 * SecurityNotice.astro
 * A premium, minimalist modal displaying the website's content protection policies.
 */
---

<div id="security-modal" class="security-modal" aria-hidden="true">
  <div class="modal-overlay" id="modal-close-trigger"></div>
  <div class="modal-content">
    <button class="close-btn" id="modal-close-btn" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-header">
      <div class="security-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2>Content Protection</h2>
    </div>

    <div class="modal-body">
      <p>
        We want to inform users visiting our website that all images and videos displayed are protected and must not be misused. 
        <strong>Strong security measures</strong> are in place to prevent unauthorized actions, including downloading, copying, or sharing content on third-party platforms.
      </p>
      
      <div class="security-feature">
        <div class="feature-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6"></path>
            <path d="m12 13 4 4 4-4"></path>
            <path d="M16 17V9"></path>
          </svg>
        </div>
        <p>Screenshots are strictly restricted across all devices, including laptops, mobiles, tablets, and even third-party screen capture tools.</p>
      </div>

      <p class="final-note">
        These protections apply to every image and video on the website to ensure full content security.
      </p>

      <div class="copyright-tag">
        All images and videos are copyrighted.
      </div>
    </div>
  </div>
</div>

<style>
  .security-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .security-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    background: #fff;
    color: #000;
    width: 100%;
    max-width: 500px;
    padding: 3rem 2.5rem;
    border-radius: 2px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.2);
    transform: translateY(20px);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: var(--font-sans);
  }

  .security-modal.active .modal-content {
    transform: translateY(0);
  }

  .close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    color: #999;
    padding: 5px;
    transition: color 0.3s;
  }

  .close-btn:hover {
    color: #000;
  }

  .modal-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .security-icon {
    display: inline-flex;
    margin-bottom: 1rem;
    color: #000;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
    text-transform: uppercase;
  }

  .modal-body {
    line-height: 1.6;
    font-size: 0.95rem;
    color: #444;
  }

  .modal-body strong {
    color: #000;
    font-weight: 500;
  }

  .security-feature {
    display: flex;
    gap: 1rem;
    background: #f8f8f8;
    padding: 1.25rem;
    margin: 1.5rem 0;
    border-left: 2px solid #000;
  }

  .feature-icon {
    flex-shrink: 0;
    color: #000;
    margin-top: 3px;
  }

  .security-feature p {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
  }

  .final-note {
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .copyright-tag {
    border-top: 1px solid #eee;
    padding-top: 1.5rem;
    text-align: center;
    font-weight: 500;
    color: #000;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 640px) {
    .modal-content {
      padding: 2.5rem 1.5rem;
    }
    .security-modal {
      padding: 1rem;
    }
  }
</style>

<script is:inline>
  function initSecurityModal() {
    const modal = document.getElementById('security-modal');
    const triggers = document.querySelectorAll('.open-security-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    const overlay = document.getElementById('modal-close-trigger');

    if (!modal) return;

    function openModal() {
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);

    // Escape key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  }

  document.addEventListener('astro:page-load', initSecurityModal);
</script>
