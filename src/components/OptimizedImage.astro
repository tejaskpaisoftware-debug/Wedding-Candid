---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
  decoding?: 'async' | 'auto' | 'sync';
}

const { src, alt, class: className, loading = 'lazy', decoding = 'async' } = Astro.props;
---

<div class="watermark-container">
  <img src={src} alt={alt} class={className} loading={loading} decoding={decoding} />
</div>

<style>
  .watermark-container {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .watermark-container img {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: auto;
  }
</style>

