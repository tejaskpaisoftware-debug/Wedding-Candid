---
import { ViewTransitions } from "astro:transitions";
import Cursor from "../components/Cursor.astro";
import Navbar from "../components/Navbar.astro";
import Preloader from "../components/Preloader.astro";
import StickyCopyright from "../components/StickyCopyright.astro";
import SecurityNotice from "../components/SecurityNotice.astro";
const { hideGlobalPreloader = false, navTheme = "light" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/03.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wedding Candid | Editorial & Wedding Portfolio</title>
  <meta name="description" content="Modern, premium photography portfolio specializing in emotional storytelling and timeless imagery.">
  <!-- Fonts are globally handled via style.css -->
  <link rel="stylesheet" href="/style.css?v=1.1">
  <ViewTransitions />
</head>

<body class={hideGlobalPreloader ? "" : "preloader-active"} data-nav-theme={navTheme}>
  <!-- Preloader -->
  { !hideGlobalPreloader && <Preloader /> }

  <div id="app">
    <!-- Navbar -->
    <Navbar />
    
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        // ── Global Curtain Reveal Observer ────────────────
        const curtainObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              setTimeout(() => entry.target.classList.add('in'), 150);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });

        document.querySelectorAll('.curtain-reveal').forEach(el => {
          curtainObserver.observe(el);
        });
      });
    </script>

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <footer class="stagger-reveal">
      <div class="footer-grid">
        <div class="footer-logo-box">
          <img src="/03.png" alt="WC Footer Logo" style="height: 120px; width: auto; object-fit: contain; margin-bottom: 2rem;">
          <div class="footer-tagline" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="color: var(--accent); flex-shrink: 0; padding-top: 0.2rem; display: flex; align-items: center; justify-content: center;" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <p style="margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-muted);">
                A-2, Jay Mahalaxmi Park, Novino-Tarsali Road, opp. Hanumanji Temple, Vadodara, Gujarat 390010
              </p>
            </div>
            <div style="display: flex; gap: 1rem; align-items: center;">
              <span style="color: var(--accent); flex-shrink: 0; display: flex; align-items: center; justify-content: center;" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <p style="margin: 0; font-size: 0.95rem; line-height: 1.6;">
                <a href="tel:+919426026504" style="text-decoration: underline; text-underline-offset: 4px; color: var(--text-charcoal); font-weight: 500; transition: color 0.3s;">94260 26504</a>
              </p>
            </div>
          </div>
          <div class="footer-socials">
            <a href="https://www.instagram.com/wedding_candid?igsh=MTI4bjlnMDlzZjk0Mg==" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="social-icon"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
              <span>Instagram</span>
            </a>
            <a href="https://youtube.com/@weddingcandiddeepmistry7777?si=zQwSc1Y0IJbYHID8" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="social-icon"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2C1 8.11 1 12 1 12s0 3.89.46 5.58a2.78 2.78 0 0 0 1.94 2c1.72.42 8.6.42 8.6.42s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2C23 15.89 23 12 23 12s0-3.89-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
              <span>YouTube</span>
            </a>
            <a href="https://wa.me/919426026504?text=Thank%20you%20for%20contacting%20Wedding%20Candid%20(%20Deep%20Mistry%20)!%20Please%20let%20us%20know%20how%20we%20can%20help%20you." target="_blank" rel="noopener noreferrer" class="social-link" aria-label="WhatsApp">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="social-icon">
                <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
                <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
              </svg>
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
        <div class="footer-col">
          <h4>Photography</h4>
          <ul class="footer-links">
            <li><a href="/photography/wedding">Wedding</a></li>
            <li><a href="/photography/pre-wedding">Pre-Wedding</a></li>
            <li><a href="/photography/bw">B/W Noir</a></li>
            <li><a href="/photography/events">Events</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/portfolio">Quick Portfolio</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/testimonials">Testimonials</a></li>
            <li><a href="/booking">Enquire</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-legal">
          <span>&copy; 2026 WEDDING CANDID. ALL RIGHTS RESERVED.</span>
          <button class="open-security-modal security-footer-link">Content Protection & Copyright</button>
        </div>
        
        <a href="https://www.tejaskpaisoftware.com/" target="_blank" rel="noopener noreferrer" class="tejaskp-credit">
          <span class="credit-text">Powered by</span>
          <img src="/tkp.png" alt="TEJASKP AI SOFTWARE" class="tejaskp-logo">
          <span class="credit-name">TEJASKP AI SOFTWARE</span>
        </a>
      </div>
    </footer>
    
    <!-- Custom Interactive Cursor -->
    <Cursor />
    <StickyCopyright />
    <SecurityNotice />
    
    <!-- Floating WhatsApp Chat Button -->
    <a href="https://wa.me/919426026504?text=Thank%20you%20for%20contacting%20Wedding%20Candid%20(%20Deep%20Mistry%20)!%20Please%20let%20us%20know%20how%20we%20can%20help%20you." target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Chat on WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" viewBox="0 0 16 16" class="whatsapp-float-icon">
        <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
      </svg>
    </a>
    
    <!-- Screenshot Protection Overlay -->
    <div id="screenshot-protection-overlay" style="display: none; position: fixed; inset: 0; z-index: 9999; background: #fff; display: none; align-items: center; justify-content: center; text-align: center; font-family: var(--font-display);">
      <div style="padding: 2rem;">
        <h2 style="text-transform: uppercase; letter-spacing: 0.1em; font-size: 1.2rem; margin-bottom: 1rem;">Protected Content</h2>
        <p style="font-family: var(--font-sans); font-size: 0.8rem; opacity: 0.6;">Screenshots are restricted to protect artistic intellectual property.</p>
      </div>
    </div>
  </div>
  <style is:global>
    :root {
      --luxury-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Page Protection Blur */
    body.page-protected #app {
      filter: blur(40px);
      transition: filter 0.2s ease;
    }
    body.page-protected .security-modal {
      display: none !important;
    }

    /* Selection color */
    ::selection {
      background: #d1b894;
      color: white;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #d1b894; border-radius: 10px; }

    /* Footer Bottom Styles */
    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 3rem 0;
      border-top: 1px solid rgba(0,0,0,0.05);
      margin-top: 4rem;
      gap: 2rem;
    }

    .footer-legal {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(0,0,0,0.4);
    }

    .tejaskp-credit {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      transition: opacity 0.3s ease;
      padding: 0;
      background: none;
      border: none;
    }

    .tejaskp-credit:hover {
      opacity: 0.7;
    }

    .credit-text {
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(0,0,0,0.4);
    }

    .tejaskp-logo {
      height: 16px;
      width: 16px;
      object-fit: cover;
      border-radius: 2px;
      display: block;
      filter: grayscale(1);
      opacity: 0.6;
      transition: all 0.3s;
    }

    .tejaskp-credit:hover .tejaskp-logo {
      filter: grayscale(0);
      opacity: 1;
    }

    .credit-name {
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(0,0,0,0.4);
      font-weight: 400;
    }

    .security-footer-link {
      background: none;
      border: none;
      padding: 0;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(0,0,0,0.4);
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 0.3s;
      text-align: left;
    }

    .security-footer-link:hover {
      color: #000;
    }

    @media (max-width: 768px) {
      .footer-bottom {
        flex-direction: column;
        text-align: center;
        gap: 2rem;
        padding-bottom: 6rem;
      }
      .footer-legal {
        align-items: center;
      }
      .security-footer-link {
        text-align: center;
      }
      .tejaskp-credit {
        padding: 0.8rem 1.5rem;
        gap: 1rem;
      }
    }
    /* Content Protection */
    img, video {
      user-select: none;
      -webkit-user-drag: none;
      pointer-events: auto;
    }
  </style>

  <script src="/global.js" type="module"></script>
  <script src="../scripts/security.js"></script>
  <script>
    import Lenis from 'lenis'
    import { gsap } from 'gsap'
    import { ScrollTrigger } from 'gsap/ScrollTrigger'

    gsap.registerPlugin(ScrollTrigger)

    let lenis: Lenis | null = null;

    // Only initialize Lenis on desktop viewports for smooth scrolling, leaving mobile to native scroll physics
    if (window.innerWidth >= 1024) {
      lenis = new Lenis()

      lenis.on('scroll', ScrollTrigger.update)

      gsap.ticker.add((time) => {
        if (lenis) lenis.raf(time * 1000)
      })

      gsap.ticker.lagSmoothing(0)
    }

    const refreshScroll = () => {
      if (lenis) {
        lenis.resize();
      }
      ScrollTrigger.refresh(true);
    };

    // REFRESH ENTIRE PAGE SCROLL LOGIC ON EVERY NAVIGATION
    document.addEventListener('astro:after-swap', () => {
      window.scrollTo(0, 0);
      if (lenis) {
        lenis.scrollTo(0, { immediate: true });
      }
      refreshScroll();
    });

    document.addEventListener('astro:page-load', () => {
      refreshScroll();
      // Delay logic to allow images and masonry components to completely mount and render
      setTimeout(refreshScroll, 400);
      setTimeout(refreshScroll, 1200);
    });

    window.addEventListener('load', refreshScroll);
    window.addEventListener('resize', refreshScroll);
  </script>
</body>
</html>
